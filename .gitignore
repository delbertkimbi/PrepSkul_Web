# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/.next-dev/
/.next-codex/
/.prepskul-dev.lock
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# Firebase service account keys (NEVER commit these!)
firebase-service-account.json
*firebase*service*account*.json
*service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local junk / leaked inventories
.DS_Store
**/.DS_Store
secrets.txt
.next-codex/
.next-dev/
.prepskul-dev.lock
*.log

# Isolated local preview and production verification
.next-preview/
.next-release/
.next-oct8/
